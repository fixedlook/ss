<Project Sdk="Microsoft.NET.Sdk">

  <!-- Book & Tape Exporter - ATAS X / classic ATAS chart indicator that dumps every
       order-event stream the platform exposes to a set of daily CSV files.

       Build (ATAS X on Windows, the default here):
           dotnet build -c Release

       Build for the classic ATAS (x86 install path):
           dotnet build -c Release -p:AtasBase="C:\Program Files (x86)\ATAS Platform"

       macOS (ATAS X):
           dotnet build -c Release -p:AtasBase="/Applications/ATAS X.app/Contents/MonoBundle"

       Output: bin/Release/net10.0-windows/BookTapeExporter.dll
       Copy that DLL into %APPDATA%\ATAS X\Extensions (or use "Add custom indicator").
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>BookTapeExporter</AssemblyName>
    <RootNamespace>Atas.Indicators.BookTape</RootNamespace>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- Where the platform is installed. Override with -p:AtasBase=... -->
    <AtasBase Condition="'$(AtasBase)' == ''">C:\Program Files\ATAS X</AtasBase>
  </PropertyGroup>

  <ItemGroup>
    <!-- The only mandatory reference. -->
    <Reference Include="ATAS.Indicators">
      <HintPath>$(AtasBase)\ATAS.Indicators.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- MBO types (MarketByOrder, MarketByOrderUpdateTypes, MarketDataType). -->
    <Reference Include="ATAS.DataFeedsCore">
      <HintPath>$(AtasBase)\ATAS.DataFeedsCore.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Utils.Common.Logging -->
    <Reference Include="Utils.Common">
      <HintPath>$(AtasBase)\Utils.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
