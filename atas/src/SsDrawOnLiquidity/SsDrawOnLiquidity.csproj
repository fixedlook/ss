<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SS Draw On Liquidity — ATAS custom indicator.

    Two ways to use this file:

      A) Open it directly (no solution needed):
           dotnet build SsDrawOnLiquidity.csproj
         The DLL lands in bin\Debug\<framework>\ and can be installed with the
         platform's "Add custom indicator" button.

      B) Copy the two .cs files into your existing ATAS indicators project and
         ignore this file entirely.

    Framework: run dotnet --info or read the "tfm" value in
    OFT.Platform.runtimeconfig.json inside your ATAS install folder, then keep
    whichever of the two targets below matches. Multitargeting is the default
    because ATAS ships both .NET 8 and .NET 10 builds and the version number in
    the platform's corner does NOT tell you which one you have.
  -->
  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>SsDrawOnLiquidity</AssemblyName>
    <RootNamespace>ATAS.Indicators.Technical</RootNamespace>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AtasPlatformDir Condition="'$(AtasPlatformDir)' == ''">C:\Program Files (x86)\ATAS Platform</AtasPlatformDir>
  </PropertyGroup>

  <!--
    ATAS assemblies are loaded by the platform at runtime, so they must never be
    copied into the output folder (Private=false / Copy Local=False).
  -->
  <ItemGroup>
    <Reference Include="ATAS.Indicators">
      <HintPath>$(AtasPlatformDir)\ATAS.Indicators.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OFT.Rendering">
      <HintPath>$(AtasPlatformDir)\OFT.Rendering.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OFT.Localization">
      <HintPath>$(AtasPlatformDir)\OFT.Localization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OFT.Attributes">
      <HintPath>$(AtasPlatformDir)\OFT.Attributes.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Utils.Common">
      <HintPath>$(AtasPlatformDir)\Utils.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
