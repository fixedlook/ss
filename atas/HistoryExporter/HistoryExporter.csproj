<Project Sdk="Microsoft.NET.Sdk">

  <!-- History Exporter - ATAS / ATAS X chart indicator.
       Dumps the bars and footprint already loaded on the chart to CSV. No live capture.

       Normal build (path is detected automatically):
           dotnet build -c Release

       If detection fails, point it at your install:
           dotnet build -c Release -p:AtasBase="C:\Program Files\ATAS X"
           dotnet build -c Release -p:AtasBase="C:\Program Files (x86)\ATAS Platform"
           dotnet build -c Release -p:AtasBase="/Applications/ATAS X.app/Contents/MonoBundle"

       Output: bin\Release\net10.0-windows\HistoryExporter.dll
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>HistoryExporter</AssemblyName>
    <RootNamespace>Atas.Indicators.HistoryExport</RootNamespace>
  </PropertyGroup>

  <!-- Find the platform: explicit -p:AtasBase wins, otherwise probe the usual install locations. -->
  <PropertyGroup>
    <AtasBase Condition="'$(AtasBase)' == '' And Exists('C:\Program Files\ATAS X\ATAS.Indicators.dll')">C:\Program Files\ATAS X</AtasBase>
    <AtasBase Condition="'$(AtasBase)' == '' And Exists('C:\Program Files (x86)\ATAS Platform\ATAS.Indicators.dll')">C:\Program Files (x86)\ATAS Platform</AtasBase>
    <AtasBase Condition="'$(AtasBase)' == '' And Exists('$(MSBuildProgramFiles32)\ATAS Platform\ATAS.Indicators.dll')">$(MSBuildProgramFiles32)\ATAS Platform</AtasBase>
    <AtasBase Condition="'$(AtasBase)' == '' And Exists('/Applications/ATAS X.app/Contents/MonoBundle/ATAS.Indicators.dll')">/Applications/ATAS X.app/Contents/MonoBundle</AtasBase>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="ATAS.Indicators">
      <HintPath>$(AtasBase)\ATAS.Indicators.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Utils.Common">
      <HintPath>$(AtasBase)\Utils.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Fail with one readable sentence instead of a wall of "type not found" errors. -->
  <Target Name="CheckAtasBase" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(AtasBase)' == '' Or !Exists('$(AtasBase)\ATAS.Indicators.dll')"
           Text="ATAS.Indicators.dll was not found. Point the build at your platform:
     dotnet build -c Release -p:AtasBase=&quot;C:\Program Files\ATAS X&quot;"
           ContinueOnError="false" />
  </Target>

  <!-- Optional: -p:Install=true also copies the DLL into the platform's Extensions folder. -->
  <!-- Optional: -p:Install=true copies the DLL into the platform's Extensions folder.
       Never fails the build: a missing app-data folder means the platform has not created one
       yet, which is not a reason to lose a good DLL. -->
  <Target Name="InstallToAtas" AfterTargets="Build" Condition="'$(Install)' == 'true'">
    <PropertyGroup>
      <AtasExtensions Condition="Exists('$(APPDATA)\ATAS X\Extensions')">$(APPDATA)\ATAS X\Extensions</AtasExtensions>
      <AtasExtensions Condition="'$(AtasExtensions)' == '' And Exists('$(APPDATA)\ATAS\Extensions')">$(APPDATA)\ATAS\Extensions</AtasExtensions>
      <AtasExtensions Condition="'$(AtasExtensions)' == '' And Exists('$(APPDATA)\ATAS\Indicators')">$(APPDATA)\ATAS\Indicators</AtasExtensions>
      <!-- Folder not created yet, but the platform's app-data root exists: make the standard one. -->
      <AtasExtensions Condition="'$(AtasExtensions)' == '' And Exists('$(APPDATA)\ATAS X')">$(APPDATA)\ATAS X\Extensions</AtasExtensions>
      <AtasExtensions Condition="'$(AtasExtensions)' == '' And Exists('$(APPDATA)\ATAS')">$(APPDATA)\ATAS\Indicators</AtasExtensions>
    </PropertyGroup>

    <MakeDir Directories="$(AtasExtensions)" Condition="'$(AtasExtensions)' != ''" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(AtasExtensions)" Condition="'$(AtasExtensions)' != ''" />

    <Message Importance="high" Condition="'$(AtasExtensions)' != ''"
             Text="Installed: $(AtasExtensions)\$(TargetFileName)" />
    <Message Importance="high" Condition="'$(AtasExtensions)' == ''"
             Text="Built: $(TargetPath)$([System.Environment]::NewLine)No ATAS app-data folder found. In ATAS use &quot;Add custom indicator&quot; and pick that file." />
  </Target>

</Project>
